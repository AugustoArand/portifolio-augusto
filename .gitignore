# ====================================
# GitHub Pages Portfolio - .gitignore
# ====================================

# Dependências do Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files (opcional - pode incluir se quiser versioning fixo)
# package-lock.json
# yarn.lock

# Build outputs (mantenha comentado para GitHub Pages)
# GitHub Pages precisa dos arquivos finais, então não ignore dist/ se usar build
# dist/
# build/

# Cache de ferramentas
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.turbo/

# Variáveis de ambiente
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Configurações do editor
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Arquivos do sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage e testes
coverage/
.nyc_output/
.coverage/
*.lcov

# Arquivos temporários
tmp/
temp/
.tmp/

# Cache do npm
.npm/
.node_repl_history

# Arquivos de package
*.tgz
*.tar.gz

# Yarn
.yarn-integrity
.yarn/
.pnp.*

# Frameworks específicos
.next/
.nuxt/
.vuepress/dist/
.serverless/

# Testes
.vscode-test/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

# Backup files
*.bak
*.backup
*.orig

# Arquivos específicos do projeto
# Descomente se não quiser commitar:
# assets/img/drafts/
# docs/private/

# GitHub Pages específico
# Não ignore estes arquivos necessários para GitHub Pages:
# index.html
# assets/
# css/
# js/
# *.html
# *.css
# *.js

# Arquivos de configuração que devem ser commitados para GitHub Pages:
# package.json (se usar)
# vite.config.js (se usar)
# README.md

# ====================================
# IMPORTANTE para GitHub Pages:
# - Certifique-se de que index.html está na raiz ou na pasta especificada
# - Todos os assets (CSS, JS, imagens) devem estar commitados
# - Não ignore arquivos essenciais para o funcionamento do site
# ====================================